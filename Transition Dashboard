// Owner tabs + project table
const ownerNames = Object.keys(projects);
const tabsEl = document.getElementById('ownerTabs');
let currentOwner = "ALL", currentFlag = "ALL", currentSearch = "";

function renderTabs(){
  tabsEl.innerHTML = '';
  const allBtn = document.createElement('button');
  allBtn.innerHTML = 'All owners<span class="n">43</span>';
  if(currentOwner==="ALL") allBtn.classList.add('active');
  allBtn.onclick = ()=>{currentOwner="ALL"; renderTabs(); renderTable();};
  tabsEl.appendChild(allBtn);
  ownerNames.forEach(name=>{
    const btn = document.createElement('button');
    btn.innerHTML = `${name}<span class="n">${projects[name].length}</span>`;
    if(currentOwner===name) btn.classList.add('active');
    btn.onclick = ()=>{currentOwner=name; renderTabs(); renderTable();};
    tabsEl.appendChild(btn);
  });
}
document.querySelectorAll('[data-flagfilter]').forEach(btn=>{
  btn.onclick = ()=>{
    document.querySelectorAll('[data-flagfilter]').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    currentFlag = btn.dataset.flagfilter;
    renderTable();
  };
});
document.getElementById('searchBox').addEventListener('input', (e)=>{ currentSearch = e.target.value.toLowerCase(); renderTable(); });

function renderTable(){
  const tbody = document.getElementById('projTableBody');
  tbody.innerHTML = '';
  const ownersToShow = currentOwner === "ALL" ? ownerNames : [currentOwner];
  ownersToShow.forEach(owner=>{
    projects[owner].forEach(([name, cat, stage, kickoff, target, sow, pct, notes, flag])=>{
      if(currentFlag !== "ALL" && flag !== currentFlag) return;
      const haystack = (name + ' ' + notes).toLowerCase();
      if(currentSearch && !haystack.includes(currentSearch)) return;
      const tr = document.createElement('tr');
      const pctLabel = pct===null ? "—" : pct + "%";
      const fillWidth = pct===null ? 0 : pct;
      const link = mondayLink(name);
      const nameHtml = link
        ? `<a href="${link}" target="_blank" rel="noopener" class="proj-name proj-link">${name}</a>`
        : `<div class="proj-name">${name}</div>`;
      tr.innerHTML = `
        <td>${nameHtml}<div style="font-size:11px;color:var(--text-faint);margin-top:2px;">${owner}</div></td>
        <td class="cat-tag">${cat}</td>
        <td class="stage-tag">${stage}</td>
        <td class="date-cell">${fmtDate(kickoff)}</td>
        <td class="date-cell">${fmtDate(target)}</td>
        <td class="sow-tag">${sow}</td>
        <td class="checklist-cell">
          <span class="mini-track"><span class="mini-fill" style="width:${fillWidth}%;background:${checklistColor(pct)}"></span></span>
          <span style="color:${checklistColor(pct)}">${pctLabel}</span>
        </td>
        <td class="notes-cell">${notes}</td>
      `;
      tbody.appendChild(tr);
    });
  });
  if(tbody.innerHTML === ''){
    tbody.innerHTML = `<tr><td colspan="8" style="color:var(--text-faint);text-align:center;padding:24px;">No projects match this filter.</td></tr>`;
  }
}
renderTabs();
