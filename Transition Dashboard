<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Transitions Portfolio — WFM Center of Excellence</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  :root{
    --bg: #0D0D0D;
    --bg-deep: #000000;
    --panel: #1A1A1A;
    --panel-raised: #262626;
    --line: #3D3D3D;
    --text: #F5F5F5;
    --text-dim: #B3B3B3;
    --text-faint: #737373;
    --red: #E5484D;
    --red-dim: #4D2426;
    --amber: #F5A623;
    --amber-dim: #4A3A1A;
    --green: #3DD16D;
    --green-dim: #1E3D28;
    --blue: #999999;
    --purple: #999999;
    --purple-deep: #F5F5F5;
    --accent-green: #FFFFFF;
    --font-head: Verdana, Geneva, sans-serif;
    --font-data: Verdana, Geneva, sans-serif;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-head);line-height:1.5;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 28px 100px;}

  .masthead{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;background:linear-gradient(150deg, #262626 0%, #000000 100%);color:#fff;padding:44px 40px 36px;margin:0 -28px 40px;}
  .masthead h1{font-size:36px;font-weight:700;margin:0 0 8px 0;letter-spacing:-0.01em;color:#fff;}
  .masthead .sub{color:#B3B3B3;font-size:14.5px;max-width:600px;}
  .masthead .meta{text-align:right;font-family:var(--font-data);font-size:12.5px;color:#8A8A8A;line-height:1.7;}
  .meta .pulse{color:var(--accent-green);}
  .meta .pulse::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--accent-green);margin-right:6px;box-shadow:0 0 6px var(--accent-green);}

  .pulse-row{display:grid;grid-template-columns: 1.3fr 1fr 1fr 1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);margin-bottom:40px;border-radius:8px;overflow:hidden;box-shadow:0 10px 28px rgba(75,40,109,0.10);margin-top:-58px;position:relative;z-index:2;}
  .pulse-cell{background:var(--panel);padding:22px 20px;}
  .pulse-cell .label{font-size:11.5px;color:var(--text-faint);margin-bottom:10px;}
  .pulse-cell .big{font-family:var(--font-data);font-size:36px;font-weight:600;line-height:1;}
  .pulse-cell .sub-label{font-size:12px;color:var(--text-dim);margin-top:6px;}
  .owner-bars{margin-top:14px;display:flex;flex-direction:column;gap:8px;}
  .owner-bar-row{display:grid;grid-template-columns:100px 1fr 40px;align-items:center;gap:8px;font-size:12px;}
  .owner-bar-track{height:6px;background:var(--bg-deep);overflow:hidden;border-radius:3px;}
  .owner-bar-fill{height:100%;background:var(--purple);border-radius:3px;}
  .owner-bar-row .count{font-family:var(--font-data);color:var(--text-dim);text-align:right;}

  .section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px;}
  .section-head h2{font-size:19px;margin:0;font-weight:600;color:var(--purple-deep);}
  .section-head .note{font-size:12.5px;color:var(--text-faint);font-family:var(--font-data);}
  section{margin-bottom:44px;}

  .stage-chart{display:flex;flex-direction:column;gap:14px;}
  .stage-row{display:grid;grid-template-columns:140px 1fr 50px;align-items:center;gap:14px;}
  .stage-row .owner{font-size:13.5px;color:var(--text-dim);}
  .stage-track{display:flex;height:22px;background:var(--bg-deep);width:100%;overflow:hidden;border-radius:4px;}
  .stage-seg{height:100%;display:flex;align-items:center;justify-content:center;font-family:var(--font-data);font-size:10.5px;color:#000;font-weight:600;}
  .stage-row .total{font-family:var(--font-data);text-align:right;color:var(--text-dim);font-size:13px;}
  .stage-legend{display:flex;gap:18px;margin-top:16px;flex-wrap:wrap;font-size:12px;color:var(--text-dim);}
  .stage-legend span{display:inline-flex;align-items:center;gap:6px;}
  .swatch{width:10px;height:10px;display:inline-block;border-radius:2px;}

  .split-row{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden;}
  .split-cell{background:var(--panel);padding:20px 22px;}
  .split-cell h3{margin:0 0 14px 0;font-size:14.5px;font-weight:600;color:var(--text-dim);}
  .health-row{display:grid;grid-template-columns:90px 1fr 34px;align-items:center;gap:10px;margin-bottom:10px;font-size:13px;}
  .health-track{height:14px;background:var(--bg-deep);overflow:hidden;border-radius:3px;}
  .health-fill{height:100%;}
  .health-row .n{font-family:var(--font-data);text-align:right;color:var(--text-dim);}
  .cat-row{display:grid;grid-template-columns:90px 1fr 34px;align-items:center;gap:10px;margin-bottom:10px;font-size:13px;}
  .cat-track{height:14px;background:var(--bg-deep);overflow:hidden;border-radius:3px;}
  .cat-fill{height:100%;background:var(--purple);}

  .catdef-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden;margin-bottom:22px;}
  .catdef-card{background:var(--panel);padding:22px 22px 20px;}
  .catdef-card .tag{display:inline-block;font-family:var(--font-data);font-size:12px;font-weight:700;color:#fff;background:var(--purple);padding:3px 9px;border-radius:4px;margin-bottom:12px;}
  .catdef-card .fullname{font-size:13px;font-weight:600;color:var(--purple-deep);margin-bottom:8px;line-height:1.4;}
  .catdef-card .desc{font-size:12.5px;color:var(--text-dim);line-height:1.55;margin-bottom:14px;}
  .catdef-card .count{font-family:var(--font-data);font-size:26px;font-weight:600;color:var(--purple);line-height:1;}
  .catdef-card .count-label{font-size:11px;color:var(--text-faint);margin-top:2px;margin-bottom:12px;}
  .catdef-card .examples{font-size:11.5px;color:var(--text-faint);border-top:1px dashed var(--line);padding-top:10px;}
  .catdef-card .examples b{color:var(--text-dim);font-weight:600;}
  @media (max-width:760px){.catdef-grid{grid-template-columns:1fr;}}

  .flag-log{display:flex;flex-direction:column;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden;}
  .flag-entry{background:var(--panel);padding:16px 20px;display:grid;grid-template-columns: 200px 1fr;gap:20px;border-left:4px solid var(--red);}
  .flag-entry.sev-med{border-left-color:var(--amber);}
  .flag-entry .fname{font-weight:600;font-size:14.5px;color:var(--purple-deep);}
  .flag-entry .ftag{display:inline-block;margin-top:6px;font-family:var(--font-data);font-size:11px;color:var(--red); border:1px solid var(--red-dim); background:var(--red-dim); padding:2px 6px;border-radius:3px;}
  .flag-entry.sev-med .ftag{color:var(--amber);border-color:var(--amber-dim);background:var(--amber-dim);}
  .flag-entry .fbody .fheadline{font-size:13.5px;color:var(--text);margin-bottom:4px;}
  .flag-entry .fbody .fdetail{font-size:13px;color:var(--text-dim);}

  .controls{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;}
  .controls button{background:var(--panel);border:1px solid var(--line);color:var(--text-dim);font-family:var(--font-data);font-size:12px;padding:7px 13px;cursor:pointer;border-radius:5px;}
  .controls button.active{background:var(--purple);color:#fff;border-color:var(--purple);}
  .search-box{background:var(--panel);border:1px solid var(--line);color:var(--text);font-family:var(--font-data);font-size:12.5px;padding:7px 12px;flex:1;min-width:160px;border-radius:5px;}
  .search-box::placeholder{color:var(--text-faint);}

  .tabs{display:flex;gap:1px;background:var(--line);border:1px solid var(--line);margin-bottom:0;border-radius:8px 8px 0 0;overflow:hidden;}
  .tabs button{flex:1;background:var(--panel);border:none;color:var(--text-dim);font-family:var(--font-head);font-size:13.5px;font-weight:500;padding:12px 10px;cursor:pointer;}
  .tabs button.active{background:var(--purple);color:#fff;}
  .tabs button .n{font-family:var(--font-data);color:var(--text-faint);font-size:11.5px;display:block;margin-top:2px;}
  .tabs button.active .n{color:#D9C9EA;}

  table{width:100%;border-collapse:collapse;font-size:12.5px;background:var(--panel);}
  thead th{text-align:left;font-family:var(--font-data);font-size:10.5px;color:var(--text-faint);padding:9px 12px;border-bottom:1px solid var(--line);font-weight:500;}
  tbody td{padding:10px 12px;border-bottom:1px solid var(--line);color:var(--text);vertical-align:top;}
  tbody tr:hover{background:var(--panel-raised);}
  tbody tr:last-child td{border-bottom:none;}
  .proj-name{font-weight:600;color:var(--purple-deep);}
  a.proj-link{text-decoration:none;border-bottom:1px dotted var(--text-faint);cursor:pointer;}
  a.proj-link:hover{color:var(--text);border-bottom-color:var(--text);}
  a.proj-link::after{content:" ↗";font-size:10px;color:var(--text-faint);}
  .cat-tag{font-family:var(--font-data);font-size:11px;color:var(--text-dim);}
  .stage-tag{font-size:11.5px;color:var(--text-dim);}
  .sow-tag{font-size:11.5px;color:var(--text-dim);font-family:var(--font-data);}
  .checklist-cell{font-family:var(--font-data);white-space:nowrap;}
  .mini-track{display:inline-block;width:50px;height:5px;background:var(--bg-deep);margin-right:8px;vertical-align:middle;border-radius:3px;}
  .mini-fill{height:100%;display:inline-block;vertical-align:top;border-radius:3px;}
  .notes-cell{color:var(--text-dim);max-width:300px;}
  .date-cell{font-family:var(--font-data);font-size:11.5px;color:var(--text-dim);white-space:nowrap;}
  .flag-chip{font-family:var(--font-data);font-size:10.5px;padding:3px 7px;display:inline-block;border:1px solid;border-radius:4px;}
  .flag-chip.RED{color:var(--red);border-color:var(--red-dim);background:var(--red-dim);}
  .flag-chip.WATCH{color:var(--amber);border-color:var(--amber-dim);background:var(--amber-dim);}
  .flag-chip.ONTRACK{color:var(--green);border-color:var(--green-dim);background:var(--green-dim);}
  .flag-chip.NA{color:var(--text-faint);border-color:var(--line);}
  .table-wrap{border:1px solid var(--line);overflow-x:auto;border-radius:8px;}

  .hold-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden;}
  .hold-card{background:var(--panel);padding:18px 20px;}
  .hold-card .hname{font-weight:600;font-size:14.5px;margin-bottom:10px;color:var(--purple-deep);}
  .hold-card .hrow{display:flex;justify-content:space-between;font-size:12.5px;color:var(--text-dim);padding:4px 0;border-bottom:1px dashed var(--line);}
  .hold-card .hrow:last-of-type{border-bottom:none;}
  .hold-card .hrow .v{font-family:var(--font-data);color:var(--text);}
  .hold-card .hnote{margin-top:10px;font-size:12.5px;color:var(--amber);}

  .legacy-card{background:var(--panel);border:1px solid var(--line);padding:22px 26px;display:flex;gap:32px;flex-wrap:wrap;align-items:center;border-radius:8px;}
  .legacy-stat{text-align:left;}
  .legacy-stat .n{font-family:var(--font-data);font-size:30px;font-weight:600;color:var(--purple);}
  .legacy-stat .l{font-size:12px;color:var(--text-faint);margin-top:4px;max-width:200px;}
  .legacy-note{flex:1;min-width:220px;font-size:12.5px;color:var(--text-dim);}

  .callout{border:1px solid var(--purple);background:var(--panel-raised);padding:16px 20px;font-size:13.5px;color:var(--text);margin-top:18px;border-radius:6px;}
  .callout strong{color:var(--purple);}

  footer{margin-top:60px;padding-top:20px;border-top:1px solid var(--line);font-family:var(--font-data);font-size:11.5px;color:var(--text-faint);display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;}

  @media (max-width:900px){.pulse-row{grid-template-columns:1fr 1fr;} .split-row{grid-template-columns:1fr;}}
  @media (max-width:720px){.flag-entry{grid-template-columns:1fr;} .stage-row{grid-template-columns:100px 1fr 40px;}}
</style>
</head>
<body>
<div class="wrap">

  <div class="masthead">
    <div>
      <h1>Transitions</h1>
      <div class="sub">WFM Center of Excellence — portfolio pulse across Gerson Jiménez, Elle Kumari and Michael Vergara.</div>
    </div>
    <div class="meta">
      v.3.2 · September 2026<br>
      <span class="pulse">synced from monday.com</span><br>
      via "Transitions Summary" + "Active Transitions" boards + Elle's Q2 2026 Checklist (Sheets)
    </div>
  </div>

  <!-- PULSE ROW -->
  <div class="pulse-row">
    <div class="pulse-cell">
      <div class="label">Active projects</div>
      <div class="big" style="color:var(--blue);">43</div>
      <div class="owner-bars">
        <div class="owner-bar-row"><span>Gerson Jiménez</span><div class="owner-bar-track"><div class="owner-bar-fill" style="width:100%"></div></div><span class="count">26</span></div>
        <div class="owner-bar-row"><span>Elle Kumari</span><div class="owner-bar-track"><div class="owner-bar-fill" style="width:38%"></div></div><span class="count">10</span></div>
        <div class="owner-bar-row"><span>Michael Vergara</span><div class="owner-bar-track"><div class="owner-bar-fill" style="width:27%"></div></div><span class="count">7</span></div>
      </div>
    </div>
    <div class="pulse-cell">
      <div class="label">On hold</div>
      <div class="big" style="color:var(--red);">4</div>
      <div class="sub-label">0% checklist, all Gerson-owned</div>
    </div>
    <div class="pulse-cell">
      <div class="label">Avg. checklist (active)</div>
      <div class="big" style="color:var(--amber);">48%</div>
      <div class="sub-label">across tracked projects</div>
    </div>
    <div class="pulse-cell">
      <div class="label">Red-flag projects</div>
      <div class="big" style="color:var(--red);">15</div>
      <div class="sub-label">checklist &lt; 30%</div>
    </div>
    <div class="pulse-cell">
      <div class="label">Closed / legacy</div>
      <div class="big" style="color:var(--text-dim);">147</div>
      <div class="sub-label">25 recent + 122 legacy, excluded above</div>
    </div>
  </div>

  <!-- STAGE DISTRIBUTION -->
  <section>
    <div class="section-head">
      <h2>Projects by stage</h2>
      <div class="note">9 pre-launch · 5 training/nesting · 2 launch · 25 BAU post-launch · 2 unassigned</div>
    </div>
    <div class="stage-chart" id="stageChart"></div>
    <div class="stage-legend">
      <span><span class="swatch" style="background:#E5484D"></span>Pre-Launch</span>
      <span><span class="swatch" style="background:#F5A623"></span>Training / Nesting</span>
      <span><span class="swatch" style="background:#8BC34A"></span>Launch</span>
      <span><span class="swatch" style="background:#3DD16D"></span>BAU Post Launch</span>
    </div>
    <div class="callout">
      <strong>Note —</strong> Michael Vergara's 7 projects (including a brand-new "Equals - Indo" program) are newly assigned Pre-Launch/unscoped programs; Gerson is working these alongside him so Michael can ramp up on the workflow.
    </div>
  </section>

  <!-- CATEGORY DEFINITIONS + MIX -->
  <section>
    <div class="section-head">
      <h2>Category mix</h2>
      <div class="note">active projects · source: monday.com</div>
    </div>

    <div class="catdef-grid">
      <div class="catdef-card">
        <span class="tag" style="background:#E5484D;">NCNB</span>
        <div class="fullname">New Customer, New Business</div>
        <div class="desc">A brand-new program for a brand-new client.</div>
        <div class="count">26</div>
        <div class="count-label">of 43 active transitions</div>
        <div class="examples"><b>Examples:</b> Centene - IN, INTUIT - SV, Sport Alliance Ramp</div>
      </div>
      <div class="catdef-card">
        <span class="tag" style="background:#F5A623;color:#1A1A1A;">ECNB</span>
        <div class="fullname">Existing Customer, New Business</div>
        <div class="desc">An existing program opening a new line of business.</div>
        <div class="count">12</div>
        <div class="count-label">of 43 active transitions</div>
        <div class="examples"><b>Examples:</b> Uber - IN, CIBC - MA, FedEx - SV</div>
      </div>
      <div class="catdef-card">
        <span class="tag" style="background:#3DD16D;color:#1A1A1A;">ECEB</span>
        <div class="fullname">Existing Customer, Existing Business</div>
        <div class="desc">An existing program opening a new geography or ramp.</div>
        <div class="count">5</div>
        <div class="count-label">of 43 active transitions</div>
        <div class="examples"><b>Examples:</b> TEMU - PH, Wayfair - IN, Tiktok BKK, HAN, SUB</div>
      </div>
    </div>

    <div class="split-cell" style="border:1px solid var(--line);border-radius:8px;">
      <div id="catChart"></div>
    </div>
  </section>

  <!-- RED FLAGS -->
  <section>
    <div class="section-head">
      <h2>Red flags &amp; escalations</h2>
      <div class="note">priority items, current monday.com status</div>
    </div>
    <div class="flag-log" id="flagLog"></div>
  </section>

  <!-- LOWEST CHECKLIST WATCHLIST -->
  <section>
    <div class="section-head">
      <h2>Watchlist — lowest checklist</h2>
      <div class="note">all at 0%, per the Live Dashboard tab</div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Project</th><th>WFM PM</th><th>Stage</th><th>Checklist</th><th>Notes</th></tr></thead>
        <tbody id="watchlistBody"></tbody>
      </table>
    </div>
  </section>

  <!-- ACTIVE PROJECTS -->
  <section>
    <div class="section-head">
      <h2>Active projects — full list</h2>
      <div class="note">43 total — filter by owner, search by name</div>
    </div>
    <div class="tabs" id="ownerTabs"></div>
    <div class="controls" style="margin-top:14px;">
      <input class="search-box" id="searchBox" placeholder="Search project name or notes…">
      <button data-flagfilter="ALL" class="active">All flags</button>
      <button data-flagfilter="RED">Red &lt;30%</button>
      <button data-flagfilter="WATCH">Watch 30–79%</button>
      <button data-flagfilter="ONTRACK">On track ≥80%</button>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Project</th><th>Category</th><th>Stage</th><th>Kickoff</th><th>Target Go-Live</th><th>SOW</th><th>Checklist</th><th>Notes</th></tr>
        </thead>
        <tbody id="projTableBody"></tbody>
      </table>
    </div>
  </section>

  <!-- ON HOLD -->
  <section>
    <div class="section-head">
      <h2>On hold</h2>
      <div class="note">not counted in the active total above — all owned by Gerson Jiménez</div>
    </div>
    <div class="hold-grid" id="holdGrid"></div>
    <div class="callout">
      <strong>Recommended next step —</strong> confirm with account/sales whether each program is still active. Ramble and VinFast have been idle 7–10+ months — recommend a firm restart date, or moving them to Closed so the active pipeline reflects real work in flight.
    </div>
  </section>

  <!-- CLOSED / LEGACY -->
  <section>
    <div class="section-head">
      <h2>Closed &amp; legacy scope</h2>
      <div class="note">excluded from the active portfolio above</div>
    </div>
    <div class="legacy-card">
      <div class="legacy-stat"><div class="n">25</div><div class="l">recently closed / handed over, with PM &amp; category on record</div></div>
      <div class="legacy-stat"><div class="n">122</div><div class="l">pre-existing legacy accounts — no PM or category recorded on the board</div></div>
      <div class="legacy-note">These 147 records sit on the same monday.com "Transitions Summary" board but are out of scope for active portfolio tracking — flagged here only so the totals above reconcile against the full board.</div>
    </div>
  </section>

  <footer>
    <span>TELUS Digital — Confidential</span>
    <span>Source: monday.com "Transitions Summary" + "Active Transitions" boards; Elle Kumari's Q2 2026 Transitions Checklist (Google Sheets)</span>
  </footer>

</div>

<script>
const STAGE_COLORS = { "Pre-Launch": "#E5484D", "Training / Nesting": "#F5A623", "Launch": "#8BC34A", "BAU Post Launch": "#3DD16D" };

const stageData = [
  {owner:"Gerson Jiménez", stages:{"Pre-Launch":2,"Training / Nesting":1,"Launch":2,"BAU Post Launch":21}, total:26},
  {owner:"Elle Kumari", stages:{"Pre-Launch":2,"Training / Nesting":4,"Launch":0,"BAU Post Launch":4}, total:10},
  {owner:"Michael Vergara", stages:{"Pre-Launch":5,"Training / Nesting":0,"Launch":0,"BAU Post Launch":0}, total:7},
];

const catData = [
  {label:"NCNB", n:26, color:"#E5484D"},
  {label:"ECNB", n:12, color:"#F5A623"},
  {label:"ECEB", n:5, color:"#3DD16D"},
];

const redFlags = [
  {sev:"high", name:"Splashdot - US", tag:"BAU Post Launch — go-live date passed", headline:"Blocked on the Five9 POC fix; WFM cannot see TMs.", detail:"Checklist 0%."},
  {sev:"high", name:"Ticketmaster - ZA / Uber - IN", tag:"Go-live Sep 21", headline:"Both targeted for go-live within days.", detail:"Checklist 9% and 0%; tooling access and hiring (12 RTAs, 1 Sr RTA, 3 Schedulers, 1 Planner, 2 WFM TL) still open on Uber."},
