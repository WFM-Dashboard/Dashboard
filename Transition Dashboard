function mondayLink(name){ return MONDAY_LINKS[name] || null; }

function checklistColor(pct){
  if(pct===null) return "var(--text-faint)";
  if(pct<30) return "var(--red)";
  if(pct<80) return "var(--amber)";
  return "var(--green)";
}
function fmtDate(d){ return d === "—" || !d ? "—" : d; }

// Stage chart
const stageChart = document.getElementById('stageChart');
stageData.forEach(row=>{
  const rowEl = document.createElement('div');
  rowEl.className = 'stage-row';
  const segs = Object.entries(row.stages).filter(([,v])=>v>0).map(([k,v])=>{
    const pct = (v/row.total*100).toFixed(1);
    return `<div class="stage-seg" style="width:${pct}%;background:${STAGE_COLORS[k]}" title="${k}: ${v}">${v}</div>`;
  }).join('');
  rowEl.innerHTML = `<div class="owner">${row.owner}</div><div class="stage-track">${segs}</div><div class="total">${row.total}</div>`;
  stageChart.appendChild(rowEl);
});

// Category chart
